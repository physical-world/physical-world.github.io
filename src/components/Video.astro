---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"video"> {
  src: string;
}

const {
  src,
  controls = true,
  loop = false,
  playsinline = true,
  muted = true,
  autoplay = true,
  ...videoProps
} = Astro.props;
---

<video
  class="aspect-video h-auto w-full rounded-lg"
  src={src}
  controls={controls}
  loop={false}
  data-loop-hold={loop || undefined}
  playsinline={playsinline}
  muted={muted}
  autoplay={autoplay}
  {...videoProps}></video>

<script>
  import { loopWithHold } from "../lib/loop-hold";

  // `loop` videos pause on the last frame before replaying (src/lib/loop-hold.ts).
  document
    .querySelectorAll<HTMLVideoElement>("video[data-loop-hold]")
    .forEach((video) => loopWithHold(video));
</script>
