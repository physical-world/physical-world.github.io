---
/**
 * Method overview figure, rebuilt in HTML/CSS from the original PPT diagram.
 *
 * Edit text directly in the markup below; math labels live in `math`.
 * Positions use the original slide coordinates (24201 x 7201 units): `box()`
 * places an element on the canvas, and children of a card use the same
 * absolute slide coordinates. Below ~700px the figure reflows into a
 * vertical layout (see method-overview.css). Images: public/figures/method/.
 */
import katex from "katex";
import "./method-overview.css";

// Replay button under the figure; hidden for now, set true to show it.
const SHOW_REPLAY = false;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const fig = (name: string) => `${base}figures/method/${name}`;
const tex = (expr: string) =>
  katex.renderToString(expr, { throwOnError: false });
// Child of a card: absolute slide coordinates, resolved against the card.
const at = (x: number, y: number, w: number, h: number) =>
  `--x:${x};--y:${y};--w:${w};--h:${h};`;
// Element on the canvas (cards also pass their box down to children).
const box = (x: number, y: number, w: number, h: number, delay?: number) =>
  at(x, y, w, h) +
  `--cx:${x};--cy:${y};--cw:${w};--ch:${h};` +
  (delay === undefined ? "" : `--d:${delay}ms;`);

const math = {
  scene: tex("\\mathcal{T}"),
  exploreActions: tex("a^{c}_{1:T_c}"),
  contextObs: tex("o^{c}_{1:T_c}"),
  encoder: tex("g_{\\phi}"),
  descriptor: tex("\\mathbf{z}_{\\text{phy}}"),
  currentObs: tex("o_t"),
  action: tex("a_t"),
  prediction: tex("\\hat{o}_{t+1}"),
  groundTruth: tex("o_{t+1}"),
};
---

<div class="method-overview" data-method-overview>
  <div
    class="mo-canvas"
    role="img"
    aria-label="(a) An uncalibrated world model imagines many possible futures under the same actions. (b) PhysiCalWorld encodes exploratory actions and in-context observations into a physics descriptor that conditions the world model's predictions."
  >
    <!-- ================= (a) Uncalibrated world model ================= -->
    <div
      class="mo-at mo-card mo-pink mo-as mo-reveal"
      style={box(303, 63, 2002, 2346, 0)}
    >
      <div class="mo-in mo-frame" style={at(432, 158, 1746, 1746)}>
        <img src={fig("test-scene.png")} alt="" />
        <span class="mo-corner" set:html={math.scene} />
      </div>
      <span class="mo-in mo-text" style={at(303, 1940, 2002, 450)}
        >Test Scene</span
      >
    </div>
    <span
      class="mo-at mo-arrow r mo-d mo-reveal"
      style={box(2228, 1162, 550, 293, 0)}></span>
    <div
      class="mo-at mo-card mo-blue mo-am mo-reveal"
      style={box(2717, 421, 1751, 1633, 0)}
    >
      <span class="mo-text">World<br />Model</span>
    </div>
    <span
      class="mo-at mo-arrow l mo-d mo-reveal"
      style={box(4375, 1162, 550, 293, 0)}></span>
    <div
      class="mo-at mo-card mo-peach mo-aa mo-reveal"
      style={box(4887, 80, 2002, 2312, 0)}
    >
      <img
        class="mo-in"
        src={fig("icon-actions.svg")}
        alt=""
        style={at(5103, 270, 1600, 1600)}
      />
      <span class="mo-in mo-text" style={at(4943, 1788, 1919, 769)}
        >Actions</span
      >
    </div>
    <span
      class="mo-at mo-arrow d mo-d mo-reveal"
      style={box(3425, 2139, 265, 771, 0)}></span>

    <div
      class="mo-at mo-card mo-gray mo-ad mo-reveal"
      style={box(247, 2773, 6609, 3696, 0)}
    >
      <div class="mo-group mo-title">
        <span class="mo-in mo-text" style={at(1596, 2809, 3850, 769)}
          >Physical Dynamics</span
        >
        <span
          class="mo-in mo-text mo-question"
          style={at(4837, 2848, 1087, 898)}>❓</span
        >
      </div>
      <div class="mo-group mo-futures">
        <div class="mo-in mo-frame" style={at(618, 3527, 1746, 1746)}>
          <img src={fig("a-future-1.png")} alt="" />
        </div>
        <div class="mo-in mo-frame" style={at(2497, 3527, 1746, 1746)}>
          <img src={fig("a-future-2.png")} alt="" />
        </div>
        <span
          class="mo-in mo-text mo-small-text"
          style={at(4243, 4037, 443, 727)}>...</span
        >
        <div class="mo-in mo-frame" style={at(4686, 3527, 1746, 1746)}>
          <img src={fig("a-future-3.png")} alt="" />
        </div>
      </div>
      <span
        class="mo-in mo-text mo-small-text"
        style={at(519, 5216, 6057, 1197)}
      >
        Various Possible Future States<br />Under the Same Actions
