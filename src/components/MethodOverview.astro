      style={box(21303, 91, 2703, 2452, 1620)}
    >
      <div class="mo-in mo-frame" style={at(21548, 170, 2246, 2247)}>
        <img src={fig("b-prediction.png")} alt="" />
        <span class="mo-corner" set:html={math.prediction} />
      </div>
      <span
        class="mo-in mo-text mo-small-text mo-on-frame"
        style={at(21332, 200, 2672, 600)}>Prediction</span
      >
    </div>
    <div
      class="mo-at mo-match mo-mm mo-reveal"
      style={box(21587, 2382, 2844, 1197, 1620)}
    >
      <span class="mo-in mo-arrow ud mo-d" style={at(21870, 2589, 199, 801)}
        ><i></i></span
      >
      <span class="mo-arrow lr mo-m"><i></i></span>
      <span
        class="mo-in mo-text mo-small-text"
        style={at(22300, 2382, 1418, 1197)}
