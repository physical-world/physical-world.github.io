        style={at(7597, 2066, 450, 450)}
      />
      <span class="mo-in mo-text" style={at(7482, 2313, 3339, 769)}>
        Test Scene&nbsp;<span set:html={math.scene} />
      </span>
      <div
        class="mo-in mo-frame mo-frame-sm"
        style={at(10400, 2127, 1128, 1128)}
