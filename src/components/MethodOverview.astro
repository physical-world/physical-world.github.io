    >
      <span class="mo-text mo-math-lg" set:html={math.encoder} />
    </div>

    <span
      class="mo-at mo-arrow r mo-d mo-reveal"
      style={box(13465, 4879, 650, 293, 900)}></span>
    <div
      class="mo-at mo-card mo-rose mo-z mo-reveal"
