        />
      </div>
    </div>
    <span
      class="mo-at mo-arrow d mo-d mo-reveal"
      style={box(9382, 1581, 277, 641, 360)}></span>
    <div
      class="mo-at mo-card mo-pink mo-e2 mo-reveal"
      style={box(7475, 2023, 4214, 1353, 360)}
    >
      <img
        class="mo-in mo-earth"
        src={fig("icon-earth.svg")}
