    </div>

    <p
      class="mo-at mo-text mo-caption mo-bcap mo-reveal"
      style={box(11130, 6800, 10701, 450, 0)}
    >
      <span
        >(b) <b>Physi</b>cs <b>Cal</b>ibration for <b>World</b> Models (Ours)</span
      >
    </p>

    <!-- Arrows used only in the narrow (vertical) layout. -->
    <span class="mo-arrow r mo-m mo-ma1 mo-reveal" style="--d:0ms"></span>
    <span class="mo-arrow l mo-m mo-ma2 mo-reveal" style="--d:0ms"></span>
    <span class="mo-arrow d mo-m mo-ml mo-reveal" style="--d:0ms"></span>
    <span class="mo-arrow d mo-m mo-md1 mo-reveal" style="--d:360ms"></span>
    <span class="mo-arrow d mo-m mo-md2 mo-reveal" style="--d:540ms"></span>
    <span class="mo-arrow d mo-m mo-md3 mo-reveal" style="--d:720ms"></span>
    <span class="mo-arrow d mo-m mo-md4 mo-reveal" style="--d:900ms"></span>
    <span class="mo-arrow d mo-m mo-mu1 mo-reveal" style="--d:1440ms"></span>
    <span class="mo-arrow d mo-m mo-mu2 mo-reveal" style="--d:1440ms"></span>
    <span class="mo-arrow d mo-m mo-mu3 mo-reveal" style="--d:1440ms"></span>
    <span class="mo-arrow d mo-m mo-md5 mo-reveal" style="--d:1620ms"></span>
  </div>

  {SHOW_REPLAY && <button type="button" class="mo-replay" data-mo-replay>↻ Replay</button>}
</div>

<script>
  // Staged entrance when the figure scrolls into view. Without JS (or with
  // reduced motion) everything is simply shown.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-method-overview]",
  )) {
    if (reduce) continue;
    root.classList.add("mo-animate");
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        root.classList.add("mo-in-view");
        observer.disconnect();
      },
      { threshold: 0.15 },
    );
    observer.observe(root);
    root.querySelector("[data-mo-replay]")?.addEventListener("click", () => {
      root.classList.remove("mo-in-view");
      void root.offsetWidth; // restart CSS animations
      root.classList.add("mo-in-view");
    });
  }
</script>
