    </div>
    <span
      class="mo-at mo-arrow d mo-d mo-reveal"
      style={box(9370, 3206, 277, 641, 540)}></span>
    <div
      class="mo-at mo-card mo-green mo-e3 mo-reveal"
      style={box(7508, 3534, 4214, 2977, 540)}
    >
      <div class="mo-group">
        <img
          class="mo-in mo-icon"
          src={fig("icon-telescope.svg")}
          alt=""
          style={at(7873, 4388, 900, 900)}
        />
        <div class="mo-group mo-stack">
          <div class="mo-in mo-frame" style={at(9104, 4194, 1546, 1546)}>
            <img src={fig("b-context-1.png")} alt="" />
          </div>
          <div class="mo-in mo-frame" style={at(9410, 3970, 1546, 1546)}>
            <img src={fig("b-context-2.png")} alt="" />
          </div>
          <div class="mo-in mo-frame" style={at(9716, 3746, 1547, 1546)}>
            <img src={fig("b-context-3.png")} alt="" />
          </div>
        </div>
      </div>
      <div class="mo-group">
        <span class="mo-in mo-text" style={at(7130, 5700, 4142, 769)}
