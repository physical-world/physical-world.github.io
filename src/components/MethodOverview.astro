        Matched<br />Dynamics
      </span>
    </div>
    <div
      class="mo-at mo-card mo-pink mo-gt mo-reveal"
      style={box(21267, 3458, 2702, 3160, 1620)}
    >
      <div class="mo-in mo-frame" style={at(21506, 3631, 2246, 2246)}>
        <img src={fig("b-ground-truth.png")} alt="" />
        <span class="mo-corner" set:html={math.groundTruth} />
