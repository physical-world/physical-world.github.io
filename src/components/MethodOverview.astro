        >
        <span
          class="mo-in mo-text"
          style={at(10387, 5671, 1340, 826)}
          set:html={math.contextObs}
        />
      </div>
    </div>

    <span
      class="mo-at mo-arrow r mo-d mo-reveal"
      style={box(11409, 804, 650, 293, 720)}></span>
    <span
      class="mo-at mo-arrow r mo-d mo-reveal"
      style={box(11409, 4879, 650, 293, 720)}></span>
    <div
      class="mo-at mo-card mo-blue mo-g mo-reveal"
