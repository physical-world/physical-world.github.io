    <span
      class="mo-at mo-arrow u mo-d mo-reveal"
      style={box(14573, 2954, 293, 897, 1440)}></span>
    <span
      class="mo-at mo-arrow u mo-d mo-reveal"
      style={box(16834, 2891, 293, 600, 1440)}></span>
    <span
      class="mo-at mo-arrow u mo-d mo-reveal"
      style={box(19503, 2965, 293, 836, 1440)}></span>

    <span
      class="mo-at mo-arrow r mo-d mo-reveal"
      style={box(20759, 1321, 570, 293, 1620)}></span>
    <div
