---
import { Icon } from "astro-icon/components";
import BrandName from "./BrandName";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
  /** Force the next author onto a new line. */
  breakAfter?: boolean;
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url?: string;
  name: string;
  icon?: string;
};

interface Props {
  title: string;
  authors: Author[];
  /** Shared affiliation shown once below the author names. */
  affiliation?: string;
  /** Logo shown instead of the affiliation text (path under public/); the text becomes its alt. */
  affiliationLogo?: string;
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, authors, affiliation, affiliationLogo, conference, notes, links } =
  Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "paper-hero full-bleed relative mb-12",
    hasBackground && "-mt-16 pt-24 pb-28",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        {/* Darken the cover so the white header text stays legible. */}
        <div class="absolute inset-0 bg-black/40" />
      </div>
    )
  }
  <div
    class:list={[
      // Header content width (max-w-[64rem]) and side padding (px-6).
      "relative z-10 mx-auto flex max-w-[64rem] flex-col items-center px-6 text-center",
      hasBackground
        ? "prose-headings:text-white gap-10 text-white [text-shadow:0_0_8px_rgba(0,0,0,0.6)]"
        : "gap-5", // Space between header rows (title, authors, affiliation, notes, buttons).
    ]}
  >
    <h1 class="hero-title my-0 text-balance">
      {
        title.startsWith("PhysiCalWorld:") ? (
          <>
            <>
              <span class="hero-name">
                <BrandName />
              </span>
              <span class="hero-subtitle">
                {title.slice("PhysiCalWorld:".length).trim()}
              </span>
            </>
          </>
        ) : (
          title
        )
      }
    </h1>
    {/* Author row: gap-x-8 = space between names, gap-y-4 = space between lines.
        Use `breakAfter: true` on an author in paper.mdx to force a line break. */}
    <div
      class="hero-authors flex flex-row flex-wrap justify-center gap-x-8 gap-y-2"
    >
      {
        authors.map((author) => (
          <>
          <div class="flex flex-col items-center text-center">
            <div class="flex flex-row text-xl">
              {author.url ? (
                <a
                  class:list={[
                    hasBackground &&
                      "not-prose text-blue-200 underline decoration-dashed underline-offset-4 hover:text-blue-100 hover:decoration-solid",
                  ]}
                  href={author.url}
                >
                  {author.name}
                </a>
              ) : (
                author.name
              )}
              {author.notes && (
                <sup class="text-xl">
                  {author.notes.map(
                    (note, index, array) =>
                      note + (index < array.length - 1 ? "," : ""),
                  )}
                </sup>
              )}
            </div>
            {author.institution && <div>{author.institution}</div>}
          </div>
          {author.breakAfter && <div class="h-0 basis-full" aria-hidden="true" />}
          </>
        ))
      }
    </div>
    {
      affiliationLogo ? (
        <img
          class="hero-affiliation-logo"
          src={prefix + affiliationLogo}
          alt={affiliation}
        />
      ) : (
        affiliation && <div class="hero-affiliation">{affiliation}</div>
      )
    }
    {conference && <div class="hero-status">{conference}</div>}
    {
      notes && (
        // Notes legend (*Equal contribution, †Equal advising): text-sm = size;
        // add e.g. -mt-2 to pull it closer to the row above.
        <div class="text-center text-sm">
          {
            // prettier-ignore
            notes.map((note, index, array) => (
              <span>
                <sup>{note.symbol}</sup>{note.text}{index < array.length - 1 ? "," : ""}
              </span>
            ))
          }
        </div>
      )
    }
    {
      links && (
        // Link buttons (PDF / arXiv / Code): gap-2 = space between buttons.
        <div class="not-prose flex flex-row flex-wrap justify-center gap-2">
          {links.map((link) => {
            // arxiv buttons
            // Button size: text-* = label/icon size, px-* / py-* = padding,
            // gap-* = space between icon and label.
            const classes = [
              "flex flex-row items-center gap-2 rounded-full px-5 py-2 text-sm hover:no-underline",
              hasBackground
                ? "bg-white text-zinc-800 shadow-[0_0_8px_rgba(0,0,0,0.6)] text-shadow-none hover:bg-zinc-200"
                : "bg-zinc-800 text-white hover:bg-black dark:bg-zinc-200 dark:text-zinc-900 dark:hover:bg-zinc-50",
            ];
            return link.url ? (
              <a href={link.url} class:list={classes}>
                {link.icon && <Icon name={link.icon} />}
                <span>{link.name}</span>
              </a>
            ) : (
              <button type="button" disabled class:list={classes}>
                {link.icon && <Icon name={link.icon} />}
                <span>{link.name}</span>
              </button>
            );
          })}
        </div>
      )
    }
  </div>
</header>

<style>
  /* Make the slotted cover (Picture/Video, or a plain <img>/<video>) fill the
     header, overriding those components' figure styling. Scoped to `.cover`.
     Kept as scoped CSS because expressing it with Tailwind would require
     repeating the descendant variant on every declaration. */
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    /* Zero the margin that `prose` adds to media elements, which would
       otherwise push the cover down and expose the page background. */
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
</style>
