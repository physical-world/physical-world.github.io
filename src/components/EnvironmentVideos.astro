---
import Carousel from "./Carousel.astro";
import CarouselSlide from "./CarouselSlide.astro";
import "./analysis-charts.css";
interface Props {
  environments: {
    id: string;
    label: string;
    videos: string[];
    rgbVideos?: (string | null)[];
    contexts?: string[];
  }[];
  title: string;
  description: string;
}

const { environments, title, description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<section data-video-gallery aria-label={title} class="not-prose my-8">
  {
    environments.map((env) => (
      <div data-environment-panel>
        <div class="rounded-xl border border-zinc-200 bg-zinc-50 p-3 sm:p-5 dark:border-zinc-700 dark:bg-zinc-800">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="text-sm font-medium">
              {env.label} · {description}
            </span>
            <div class="flex flex-wrap items-center gap-4">
              {env.contexts && (
                <label class="flex items-center gap-2 text-sm font-medium">
                  <input
                    data-context-toggle
                    type="checkbox"
                    role="switch"
                    class="rounded border-zinc-400 text-blue-600 focus:ring-blue-500"
                  />
                  Show context
                </label>
              )}
              {env.rgbVideos && (
                <label class="flex items-center gap-2 text-sm font-medium">
                  <input
                    data-mask-toggle
                    type="checkbox"
                    role="switch"
                    checked
                    class="rounded border-zinc-400 text-blue-600 focus:ring-blue-500"
                  />
                  Show mask
                </label>
              )}
            </div>
          </div>
          <Carousel contained>
            {env.videos.map((src, i) => (
              <CarouselSlide>
                <video
                  data-src={base + src}
                  data-playback-rate={env.id === "beerpong" ? 0.75 : 1}
                  data-rgb-src={
                    env.rgbVideos?.[i] ? base + env.rgbVideos[i] : undefined
                  }
                  autoplay
                  controls
                  muted
                  playsinline
                  preload="metadata"
                  aria-label={`${env.label} ${title} example ${i + 1}`}
                  class="h-auto w-full rounded-lg"
                />
                {env.contexts?.[i] && (
                  <figure data-context-clip hidden class="pt-4">
                    <img
                      src={base + env.contexts[i]}
                      alt={`${env.label} context clip for example ${i + 1}`}
                      loading="lazy"
                      class="h-auto w-full rounded-lg bg-white"
                    />
                  </figure>
                )}
              </CarouselSlide>
            ))}
          </Carousel>
          {Astro.slots.has("caption") && (
            <p class="chart-note">
              <slot name="caption" />
            </p>
          )}
        </div>
      </div>
    ))
  }
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-video-gallery]")
    .forEach((gallery) => {
      const toggles =
        gallery.querySelectorAll<HTMLInputElement>("[data-mask-toggle]");
      const contextToggles = gallery.querySelectorAll<HTMLInputElement>(
        "[data-context-toggle]",
      );
      contextToggles.forEach((toggle) =>
        toggle.addEventListener("change", () => {
          const enabled = toggle.checked;
          contextToggles.forEach((other) => {
            other.checked = enabled;
          });
          gallery
            .querySelectorAll<HTMLElement>("[data-context-clip]")
            .forEach((clip) => {
              clip.hidden = !enabled;
            });
        }),
      );
      let maskEnabled = true;
      const updates: (() => void)[] = [];
      gallery
        .querySelectorAll<HTMLElement>("[data-environment-panel]")
        .forEach((panel) => {
          const carousel =
            panel.querySelector<HTMLElement>(".carousel-wrapper")!;
          panel
            .querySelectorAll<HTMLVideoElement>("video")
            .forEach((video, index) => {
              const playbackRate = Number(video.dataset.playbackRate ?? 1);
              video.defaultPlaybackRate = playbackRate;
              video.playbackRate = playbackRate;
              let pendingTime: number | null = null;
              let resumePlayback = false;
              const active = () =>
                Number(carousel.dataset.currentIndex ?? 0) === index;
              video.addEventListener("loadedmetadata", () => {
                video.playbackRate = playbackRate;
                if (pendingTime !== null) {
                  video.currentTime = Math.min(
                    pendingTime,
                    video.duration || 0,
                  );
                  pendingTime = null;
                }
                if (resumePlayback && active())
                  void video.play().catch(() => {});
                resumePlayback = false;
              });
              const update = () => {
                video.autoplay = active();
                if (!active()) {
                  video.pause();
                  resumePlayback = false;
                  return;
                }
                const toggle =
                  panel.querySelector<HTMLInputElement>("[data-mask-toggle]");
                if (toggle) {
                  toggle.disabled = !video.dataset.rgbSrc;
                  toggle.checked = maskEnabled && !toggle.disabled;
                }
                const src = !maskEnabled
                  ? (video.dataset.rgbSrc ?? video.dataset.src!)
                  : video.dataset.src!;
                if (video.getAttribute("src") !== src) {
                  pendingTime = pendingTime ?? video.currentTime;
                  resumePlayback = true;
                  video.pause();
                  video.src = src;
                  video.load();
                } else {
                  void video.play().catch(() => {});
                }
              };
              // Retry when entering view: browsers may suspend muted autoplay
              // while the gallery is offscreen, even after metadata has loaded.
              new IntersectionObserver(
                ([entry]) => {
                  if (entry.isIntersecting && active())
                    void video.play().catch(() => {});
                },
                { threshold: 0.1 },
              ).observe(video);
              updates.push(update);
              carousel.addEventListener("carousel:change", update);
              update();
            });
        });
      toggles.forEach((toggle) =>
        toggle.addEventListener("change", () => {
          maskEnabled = toggle.checked;
          toggles.forEach((other) => {
            other.checked = maskEnabled;
          });
          updates.forEach((update) => update());
        }),
      );
    });
</script>
