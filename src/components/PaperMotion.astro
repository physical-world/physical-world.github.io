<div class="reading-progress" aria-hidden="true"></div>
<nav class="chapter-nav" aria-label="Paper sections">
  <div class="chapter-nav-title">Contents</div>
  <ol></ol>
</nav>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const headings = [
    ...document.querySelectorAll<HTMLHeadingElement>(
      "main h2[id], main h3[id]",
    ),
  ];
  const nav = document.querySelector<HTMLElement>(".chapter-nav")!;
  const list = nav.querySelector("ol")!;
  const compact = document.querySelector<HTMLDetailsElement>(".mobile-toc")!;
  const compactNav = compact.querySelector("nav")!;
  let section: HTMLLIElement | undefined;
  const makeLink = (heading: HTMLHeadingElement) => {
    const link = document.createElement("a");
    link.href = `#${heading.id}`;
    // Preserve inline styling, including BrandName spans, without duplicating IDs.
    heading.childNodes.forEach((node) => link.append(node.cloneNode(true)));
    link.querySelectorAll("[id]").forEach((node) => node.removeAttribute("id"));
    return link;
  };
  headings.forEach((heading) => {
    const item = document.createElement("li");
    item.append(makeLink(heading));
    if (heading.tagName === "H2") {
      section = item;
      list.append(item);
      compactNav.append(makeLink(heading));
    } else if (section) {
      let children = section.querySelector("ul");
      if (!children) {
        children = document.createElement("ul");
        section.append(children);
      }
      children.append(item);
    }
  });
  compact.hidden = false;
  compactNav.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) compact.open = false;
  });
  const links = [...nav.querySelectorAll("a")];
  const compactLinks = [...compactNav.querySelectorAll("a")];
  const progress = document.querySelector<HTMLElement>(".reading-progress")!;
  let scheduled = false;
  const update = () => {
    const range = document.documentElement.scrollHeight - innerHeight;
    const fraction = range > 0 ? Math.max(0, Math.min(1, scrollY / range)) : 0;
    progress.style.transform = `scaleX(${fraction})`;
    let active = 0;
    let activeSection = 0;
    headings.forEach((h, i) => {
      if (h.getBoundingClientRect().top <= 130) active = i;
    });
    if (range > 0 && fraction >= 0.995) active = headings.length - 1;
    for (let i = 0; i <= active; i++) {
      if (headings[i]?.tagName === "H2") activeSection = i;
    }
    links.forEach((a, i) => {
      if (i === active) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    });
    compactLinks.forEach((a) => {
      if (a.hash === `#${headings[activeSection]?.id}`)
        a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    });
    scheduled = false;
  };
  addEventListener(
    "scroll",
    () => {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  addEventListener("resize", update);
  addEventListener("load", update);
  update();

  const targets = document.querySelectorAll<HTMLElement>(
    "main > h2, main > figure, .abstract-panel, [data-video-gallery], .analysis-card",
  );
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (isIntersecting) {
          target.classList.add("is-revealed");
          observer.unobserve(target);
        }
      });
    },
    { threshold: 0.06, rootMargin: "0px 0px -24px 0px" },
  );
  targets.forEach((target) => {
    if (!reduced.matches && target.getBoundingClientRect().top > innerHeight) {
      target.classList.add("reveal-on-scroll");
      observer.observe(target);
    }
  });
  reduced.addEventListener("change", () => {
    if (reduced.matches) {
      targets.forEach((target) => target.classList.add("is-revealed"));
      observer.disconnect();
    }
  });
</script>
