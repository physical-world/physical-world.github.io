---
import "./analysis-charts.css";

interface Props {
  environment: string;
  label: string;
}

const { environment, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<div class="not-prose pt-4">
  <video
    data-benchmark-comparison
    src={`${base}videos/benchmark/${environment}/comparison.mp4`}
    autoplay
    controls
    muted
    playsinline
    preload="metadata"
    aria-label={`${label} physics comparison`}
    class="h-auto w-full rounded-lg"></video>
  <p class="chart-note text-justify"><slot name="caption" /></p>
</div>

<script>
  import { loopWithHold } from "../lib/loop-hold";

  document
    .querySelectorAll<HTMLVideoElement>("[data-benchmark-comparison]")
    .forEach((video) => {
      const panel = video.closest<HTMLElement>("[data-tabs-content]");
      const updatePlayback = () => {
        video.autoplay = !panel?.hidden;
        if (video.autoplay) void video.play().catch(() => {});
        else video.pause();
      };
      // Loops with a pause on the last frame (length: src/lib/loop-hold.ts).
      loopWithHold(video, () => !panel?.hidden);
      updatePlayback();
      if (panel) {
        new MutationObserver(updatePlayback).observe(panel, {
          attributes: true,
          attributeFilter: ["hidden"],
        });
      }
    });
</script>
